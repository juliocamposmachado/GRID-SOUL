import express from 'express';
import helmet from 'helmet';
import rateLimit from 'express-rate-limit';
import { chromium } from 'playwright';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import fs from 'node:fs';

const ROOT = path.dirname(fileURLToPath(import.meta.url));
const app = express();

app.disable('x-powered-by');
app.use(helmet({ contentSecurityPolicy: false }));
app.use(express.json({ limit: '8kb' }));
app.use('/api/', rateLimit({ windowMs: 60_000, limit: 12 }));

const shapes = ['sphere', 'torus', 'spiral', 'wave', 'cloud', 'face', 'custom'];
const partKinds = ['sphere', 'ellipsoid', 'torus', 'cylinder', 'cone', 'box'];

let browser = null;
let context = null;
let page = null;
let busy = false;

const clamp = (value, min, max, fallback) => {
  const n = Number(value);
  return Number.isFinite(n) ? Math.max(min, Math.min(max, n)) : fallback;
};

async function openChatGPT() {
  if (browser && browser.isConnected() && page && !page.isClosed()) {
    return page;
  }

  browser = await chromium.connectOverCDP('http://127.0.0.1:9222');
  context = browser.contexts()[0];

  if (!context) {
    throw new Error('Nenhuma sessão do Chrome disponível na porta 9222.');
  }

  const pages = context.pages();
  page = pages.find(p => /(^|\.)chatgpt\.com$/i.test(new URL(p.url()).hostname));

  if (!page) {
    page = pages.find(p => p.url() === 'about:blank');
    if (!page) page = await context.newPage();
    await page.goto('https://chatgpt.com/', { waitUntil: 'domcontentloaded' });
  }

  console.log('GRID SOUL conectado à sessão existente do Chrome via CDP.');

  const composer = page.locator(
    '[data-testid="prompt-textarea"], #prompt-textarea, textarea'
  ).first();

  try {
    await composer.waitFor({ state: 'visible', timeout: 180000 });
  } catch {
    throw new Error(
      'Campo de mensagem não encontrado no ChatGPT. Verifique login e interface na aba do Chrome.'
    );
  }

  return page;
}

function extractJSON(raw) {
  const cleaned = raw
    .replace(/```(?:json)?/gi, '')
    .replace(/```/g, '')
    .trim();

  const start = cleaned.indexOf('{');
  const end = cleaned.lastIndexOf('}');
  if (start < 0 || end <= start) throw new Error('A resposta não contém JSON.');
  return JSON.parse(cleaned.slice(start, end + 1));
}

function sanitizePlan(p) {
  if (!p || typeof p !== 'object') throw new Error('Plano inválido.');

  const color = typeof p.color === 'string' && /^#[0-9a-fA-F]{6}$/.test(p.color)
    ? p.color : '#35eaff';

  const parts = (Array.isArray(p.parts) ? p.parts : [])
    .slice(0, 24)
    .filter(part => part && partKinds.includes(part.kind))
    .map(part => ({
      kind: part.kind,
      x: clamp(part.x, -4, 4, 0),
      y: clamp(part.y, -4, 4, 0),
      z: clamp(part.z, -4, 4, 0),
      sx: clamp(part.sx, 0.05, 3, 1),
      sy: clamp(part.sy, 0.05, 3, 1),
      sz: clamp(part.sz, 0.05, 3, 1),
      rx: clamp(part.rx, -6.28, 6.28, 0),
      ry: clamp(part.ry, -6.28, 6.28, 0),
      rz: clamp(part.rz, -6.28, 6.28, 0)
    }));

  const shape = shapes.includes(p.shape) ? p.shape : 'cloud';

  return {
    reply: String(p.reply || 'Plano recebido do ChatGPT.').slice(0, 700),
    shape: shape === 'custom' && parts.length === 0 ? 'cloud' : shape,
    population: Math.round(clamp(p.population, 1000, 500000, 6000)),
    energy: clamp(p.energy, 0, 1, 0.6),
    scale: clamp(p.scale, 0.5, 8, 2),
    rotationX: clamp(p.rotationX, -6.28, 6.28, 0),
    rotationY: clamp(p.rotationY, -6.28, 6.28, 0),
    rotationZ: clamp(p.rotationZ, -6.28, 6.28, 0),
    moveX: clamp(p.moveX, -10, 10, 0),
    moveY: clamp(p.moveY, -10, 10, 0),
    moveZ: clamp(p.moveZ, -10, 10, 0),
    color,
    parts
  };
}

app.get('/api/health', (_req, res) => {
  res.json({
    ok: true,
    service: 'GRID SOUL',
    brain: 'ChatGPT via Chrome + Playwright',
    browserReady: Boolean(context && page && !page.isClosed()),
    busy
  });
});

app.post('/api/command', async (req, res) => {
  const message = req.body?.message;

  if (typeof message !== 'string' || !message.trim() || message.length > 1200) {
    return res.status(400).json({ error: 'Informe um comando de até 1200 caracteres.' });
  }

  if (busy) {
    return res.status(429).json({ error: 'O GRID SOUL já está aguardando outra resposta do ChatGPT.' });
  }

  busy = true;

  try {
    const chat = await openChatGPT();
    const composer = chat.locator('[data-testid="prompt-textarea"], #prompt-textarea, textarea').first();
    const previousMessages = chat.locator('[data-message-author-role="assistant"]');
    const previousCount = await previousMessages.count();
    const previousText = previousCount
      ? (await previousMessages.nth(previousCount - 1).innerText().catch(() => '')).trim()
      : '';

    const prompt = [
      'Você é o cérebro de GRID SOUL, um único enxame visual coordenado de microcubos 3D.',
      'Interprete o pedido do usuário e devolva SOMENTE um objeto JSON válido, sem markdown nem texto externo.',
      'Use exatamente estes campos: reply, shape, population, energy, scale, rotationX, rotationY, rotationZ, moveX, moveY, moveZ, color, parts.',
      'shape permitido: sphere, torus, spiral, wave, cloud, face, custom.',
      'Para rosto humanoide, escolha face. population inteiro entre 1000 e 500000; energy entre 0 e 1; scale entre 0.5 e 8.',
      'Rotações entre -6.28 e 6.28; moveX, moveY, moveZ entre -10 e 10; color hexadecimal #RRGGBB.',
      'parts deve ser [] exceto quando shape for custom. Para custom, crie até 24 partes que formem uma única figura.',
      'Cada parte deve ter kind, x, y, z, sx, sy, sz, rx, ry, rz.',
      'kind permitido: sphere, ellipsoid, torus, cylinder, cone, box.',
      'Posições de partes entre -4 e 4; dimensões entre 0.05 e 3; rotações entre -6.28 e 6.28.',
      'Não produza código executável. Não solicite nem execute comandos do sistema. Escolha uma forma coerente e segura.',
      'Pedido do usuário: ' + message.trim()
    ].join('\n');

    await composer.fill(prompt);
    const sendButton = chat.locator('[data-testid="send-button"]');
    await sendButton.waitFor({ state: 'visible', timeout: 15000 });
    await sendButton.click();

    await chat.waitForFunction(
      ({ oldText }) => {
        const nodes = document.querySelectorAll('[data-message-author-role="assistant"]');
        if (!nodes.length) return false;
        const text = nodes[nodes.length - 1].innerText.trim();
        const generating = document.querySelector('[data-testid="stop-button"]');
        return Boolean(text && text !== oldText && !generating);
      },
      { oldText: previousText },
      { timeout: 180000 }
    );

    const messages = chat.locator('[data-message-author-role="assistant"]');
    const raw = (await messages.nth(await messages.count() - 1).innerText()).trim();
    const plan = sanitizePlan(extractJSON(raw));
    res.json(plan);
  } catch (err) {
    console.error('ChatGPT bridge:', String(err.message || err).slice(0, 500));
    res.status(502).json({
      error: 'Não foi possível obter um plano válido do ChatGPT. Confira o Chrome, o login e a resposta.'
    });
  } finally {
    busy = false;
  }
});

app.use(express.static(path.join(ROOT, 'public')));

app.listen(8765, '127.0.0.1', () => {
  console.log('GRID SOUL: http://127.0.0.1:8765');
  console.log('Cérebro: ChatGPT via Chrome + Playwright. Gemini não é necessário.');
});
