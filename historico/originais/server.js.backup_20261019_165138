let busy = false;
let cdpBrowser = null;

async function getChatGPTPage() {
  if (!cdpBrowser || !cdpBrowser.isConnected()) {
    cdpBrowser = await chromium.connectOverCDP("http://127.0.0.1:9222");
  }

  const contexts = cdpBrowser.contexts();
  if (!contexts.length) throw new Error("Nenhum contexto Chrome disponível.");

  const context = contexts[0];
  let pages = context.pages();
  let page = pages.find(p => /chatgpt\.com|chat\.openai\.com/.test(p.url()));

  if (!page) {
    page = pages[0] || await context.newPage();
    await page.goto("https://chatgpt.com/", { waitUntil: "domcontentloaded", timeout: 30000 });
  }

  await page.bringToFront();
  return page;
}

async function firstVisible(page, selectors) {
  for (const selector of selectors) {
    const locator = page.locator(selector).first();
    if (await locator.count().catch(() => 0)) {
      if (await locator.isVisible().catch(() => false)) return locator;
    }
  }
  return null;
}

async function askChatGPT(prompt) {
  const page = await getChatGPTPage();
  const composer = await firstVisible(page, [
    "#prompt-textarea",
    '[data-testid="prompt-textarea"]',
    '[contenteditable="true"][role="textbox"]',
    "textarea"
  ]);

  if (!composer) {
    throw new Error("Campo de mensagem não encontrado. Confirme se o ChatGPT está conectado nessa janela.");
  }

  const messages = page.locator('[data-message-author-role="assistant"]');
  const oldCount = await messages.count();
  const oldLast = oldCount ? (await messages.nth(oldCount - 1).innerText().catch(() => "")) : "";

  await composer.fill(prompt);
  const send = await firstVisible(page, [
    'button[data-testid="send-button"]',
    'button[aria-label="Send prompt"]',
    'button[aria-label*="Send"]',
    'button[aria-label*="Enviar"]'
  ]);

  if (!send) throw new Error("Botão Enviar não encontrado no ChatGPT.");
  await send.click();

  const deadline = Date.now() + 180000;
  let lastText = "";
  let stableSince = Date.now();
  let sawResponse = false;

  while (Date.now() < deadline) {
    await page.waitForTimeout(500);

    const count = await messages.count();
    const current = count ? (await messages.nth(count - 1).innerText().catch(() => "")).trim() : "";
    const changed = Boolean(current) && (count > oldCount || current !== oldLast);

    if (changed) {
      sawResponse = true;
      if (current !== lastText) {
        lastText = current;
        stableSince = Date.now();
      }
    }

    const generating = await firstVisible(page, [
      'button[data-testid="stop-button"]',
      'button[aria-label*="Stop generating"]',
      'button[aria-label*="Parar"]'
    ]);

    if (generating) {
      stableSince = Date.now();
    } else if (sawResponse && lastText && Date.now() - stableSince > 1800) {
      return lastText;
    }
  }

  throw new Error("Tempo esgotado aguardando a resposta completa do ChatGPT.");
}

